# Rust build artifacts
myd/target/

# Archives kept in the tree for performance testing. These are large real-world
# containers, not fixtures — the tests that need an archive build their own.
*.rar
*.zip
*.7z
*.iso
*.cab
*.tar
*.tar.*
*.tgz
*.cbz
*.cbr
*.cbt
*.cb7

# Images kept in the tree for preview testing, for the same reason as the
# archives above: real files at real sizes, which is what the size-dependent
# render paths need, and not something to carry in the repository.
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.heic

# General
__pycache__/
*.py[cod]
*.pyo
*.swp
*.swo
.idea/
.vscode/
.mypy_cache/
.pytest_cache/
